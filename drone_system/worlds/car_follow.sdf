<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="default">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>true</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="car">
      <pose>10 0 0.5 0 0 0</pose>
      <static>false</static>
      <self_collide>false</self_collide>
      <allow_auto_disable>false</allow_auto_disable>
      <link name="chassis">
        <gravity>false</gravity>
        <inertial>
          <mass>1200</mass>
          <inertia>
            <ixx>350</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1200</iyy><iyz>0</iyz><izz>1300</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry><box><size>4.0 1.8 0.8</size></box></geometry>
        </collision>
        <visual name="body_visual">
          <geometry><box><size>4.0 1.8 0.8</size></box></geometry>
          <material>
            <ambient>0.05 0.15 0.75 1</ambient>
            <diffuse>0.05 0.15 0.75 1</diffuse>
          </material>
        </visual>
        <visual name="roof_visual">
          <pose>-0.25 0 0.55 0 0 0</pose>
          <geometry><box><size>2.0 1.55 0.55</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.10 1</ambient>
            <diffuse>0.08 0.08 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="front_marker">
          <pose>2.05 0 0.0 0 0 0</pose>
          <geometry><box><size>0.12 1.0 0.25</size></box></geometry>
          <material><ambient>1 0.8 0.1 1</ambient><diffuse>1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="libcar_motion_plugin.so" name="drone_assessment::FigureEightMotion">
        <center_x>10.0</center_x>
        <center_y>0.0</center_y>
        <height>0.5</height>
        <amplitude_x>10.0</amplitude_x>
        <amplitude_y>6.0</amplitude_y>
        <period_s>28.0</period_s>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>car</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/car/odometry</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
